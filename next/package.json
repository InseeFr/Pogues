{
  "name": "pogues",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "generate-routes": "tsr generate",
    "watch-routes": "tsr watch",
    "prepare": "vite-envs update-types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "dev": "pnpm run generate-routes && vite",
    "dev:standalone": "pnpm run generate-routes && node --env-file=../.env.standalone ./node_modules/vite/bin/vite.js --mode standalone",
    "dev:api": "pnpm run generate-routes && node --env-file=../.env.local-api ./node_modules/vite/bin/vite.js",
    "build": "tsc && pnpm run generate-routes && vite build",
    "build:standalone": "tsc && pnpm run generate-routes && node --env-file=../.env.standalone ./node_modules/vite/bin/vite.js build --mode standalone",
    "build:api": "tsc && pnpm run generate-routes && node --env-file=../.env.local-api ./node_modules/vite/bin/vite.js build",
    "lint": "eslint .",
    "_format": "prettier --ignore-unknown .",
    "format": "pnpm run _format -- --write",
    "format:check": "pnpm run _format -- --list-different",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/open-sans": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@making-sense/antlr-editor": "^2.9.5",
    "@making-sense/antlr4ng": "^3.0.16",
    "@making-sense/vtl-2-1-antlr-tools-ts": "^1.0.6",
    "@making-sense/vtl-2-1-monaco-tools-ts": "^1.0.2",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "oidc-spa": "^10.2.15",
    "papaparse": "^5.7.0",
    "prismjs": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.89.0",
    "react-hot-toast": "^2.6.1",
    "react-i18next": "^17.0.15",
    "vite-envs": "^4.7.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@module-federation/enhanced": "^2.9.2",
    "@module-federation/vite": "^1.23.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/papaparse": "^5.5.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "nock": "^14.0.17",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
