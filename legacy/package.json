  "scripts": {
    "dev": "vite --port 5145",
    "build": "vite build",
    "build:standalone": "node --env-file=../.env.standalone ./node_modules/vite/bin/vite.js build --mode standalone",
    "preview": "vite preview --port 5145",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "_format": "prettier --ignore-unknown .",
    "format": "pnpm run _format -- --write",
    "format:check": "pnpm run _format -- --list-different",
    "postinstall": "shx cp src/bootstrap-custom/_variables.scss node_modules/bootstrap-sass/assets/stylesheets/bootstrap/",
    "prepare": "husky"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@making-sense/antlr-editor": "^2.9.4",
    "@making-sense/antlr4ng": "^3.0.16",
    "@making-sense/vtl-2-1-antlr-tools-ts": "^1.0.6",
    "@making-sense/vtl-2-1-monaco-tools-ts": "^1.0.2",
    "draft-js": "0.11.7",
    "draft-js-import-element": "1.4.0",
