    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.0.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react-classset": "0.0.2",
    "redux-logger": "3.0.6",
    "sass": "1.102.0",
    "shx": "^0.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-envs": "^4.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write --list-different"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx)": "prettier --write --ignore-unknown --list-different"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module"
}
