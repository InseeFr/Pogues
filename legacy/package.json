    "react-dom": "^19.2.8",
    "react-loader-spinner": "^8.0.0",
    "react-modal": "3.16.3",
    "react-redux": "7.2.9",
    "react-router-dom": "^5.0.1",
    "react-router-navigation-prompt": "^1.8.10",
    "redux": "4.2.1",
    "redux-form": "8.3.10",
