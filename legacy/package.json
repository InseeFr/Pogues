{
  "name": "pogues",
  "description": "Outil de conception et de test de questionnaires.",
  "repository": {
    "type": "git",
    "url": "https://github.com/InseeFr/Pogues"
  },
  "author": "INSEE (http://www.insee.fr)",
  "contributors": [
    {
      "name": "Franck Cotton",
      "email": "franck.cotton@insee.fr"
    },
    {
